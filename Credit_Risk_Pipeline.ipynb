{
  "cells": [
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "# Credit Risk Prediction Pipeline - Complete Walkthrough\n",
        "\n",
        "This notebook demonstrates the complete credit risk prediction pipeline using a stacked ensemble approach.\n",
        "\n",
        "## Dataset\n",
        "- German Credit (UCI ID: 144)\n",
        "- Taiwanese Credit (UCI ID: 350)\n",
        "- Australian Credit (UCI ID: 143)\n"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": ["## Step 0: Setup and Dependencies"]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "source": [
        "# Install required packages\n",
        "!pip install -q pandas numpy scikit-learn xgboost imbalanced-learn tensorflow ucimlrepo matplotlib seaborn shap fastapi uvicorn pydantic joblib\n",
        "\n",
        "import warnings\n",
        "warnings.filterwarnings('ignore')\n",
        "\n",
        "import logging\n",
        "logging.basicConfig(level=logging.INFO, format='%(asctime)s - %(name)s - %(levelname)s - %(message)s')\n",
        "\n",
        "print('\"All dependencies installed!')"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": ["## Step 1: Load and Explore Data"]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "source": [
        "# Import modules\n",
        "from data_loader import load_and_unify_data\n",
        "\n",
        "# Load and unify datasets\n",
        "df, metadata = load_and_unify_data()\n",
        "\n",
        "print(f'\"Unified dataset shape: {df.shape}')\n",
        "print(f'\"\\nColumns: {df.columns.tolist()}')\n",
        "print(f'\"\\nMetadata: {metadata}')"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": ["## Step 2: Preprocessing"]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "source": [
        "from preprocessing import preprocess_data\n",
        "\n",
        "# Preprocess and split data\n",
        "X_train, X_val, X_test, y_train, y_val, y_test, preprocessor = preprocess_data(df)\n",
        "\n",
        "print(f'\"X_train shape: {X_train.shape}')\n",
        "print(f'\"X_val shape: {X_val.shape}')\n",
        "print(f'\"X_test shape: {X_test.shape}')\n",
        "print(f'\"\\nClass distribution (train): {y_train.value_counts().to_dict()}')\n",
        "print(f'\"Class distribution (val): {y_val.value_counts().to_dict()}')\n",
        "print(f'\"Class distribution (test): {y_test.value_counts().to_dict()}')"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": ["## Step 3: Feature Selection"]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "source": [
        "from feature_selection import select_features\n",
        "\n",
        "# Feature selection\n",
        "X_train_fs, X_val_fs, X_test_fs, fs_meta = select_features(\n",
        "    X_train.copy(), X_val.copy(), X_test.copy(), y_train\n",
        ")\n",
        "\n",
        "print(f'\"Initial features: {X_train.shape[1]}')\n",
        "print(f'\"Final features: {X_train_fs.shape[1]}')\n",
        "print(f'\"Feature reduction: {100 * (1 - X_train_fs.shape[1]/X_train.shape[1]):.1f}%')"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": ["## Step 4: Handle Imbalance"]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "source": [
        "from imbalance import apply_smote\n",
        "\n",
        "# Apply SMOTE\n",
        "X_train_balanced, y_train_balanced = apply_smote(X_train_fs, y_train, sampling_strategy=0.8)\n",
        "\n",
        "print(f'\"Before SMOTE: {y_train.value_counts().to_dict()}')\n",
        "print(f'\"After SMOTE: {y_train_balanced.value_counts().to_dict()}')"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": ["## Step 5: Build Base Learners"]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "source": [
        "from models import build_base_learners\n",
        "\n",
        "# Build base learners\n",
        "base_learners = build_base_learners()\n",
        "\n",
        "print(f'\"Base learners built: {list(base_learners.keys())}')"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": ["## Step 6: Train Stacking Ensemble"]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "source": [
        "from models import build_stacking_classifier\n",
        "\n",
        "# Build and train stacking classifier\n",
        "stacking_clf = build_stacking_classifier(X_train_balanced, y_train_balanced, base_learners)\n",
        "stacking_clf.fit(X_train_balanced, y_train_balanced)\n",
        "\n",
        "print('Stacking ensemble trained successfully!')"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": ["## Step 7: Train Base Learners Individually"]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "source": [
        "# Train individual base learners\n",
        "individual_models = {}\n",
        "for name, model in base_learners.items():\n",
        "    model_clone = model.__class__(**model.get_params())\n",
        "    model_clone.fit(X_train_balanced, y_train_balanced)\n",
        "    individual_models[name] = model_clone\n",
        "    print(f'Trained {name}')\n",
        "\n",
        "print(f'\"\\nAll {len(individual_models)} base learners trained!')"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": ["## Step 8: Evaluate Models"]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "source": [
        "from sklearn.metrics import accuracy_score, roc_auc_score, precision_score, recall_score, f1_score, confusion_matrix\n",
        "from evaluate import evaluate_model\n",
        "\n",
        "# Evaluate base learners\n",
        "results = {}\n",
        "roc_data = {}\n",
        "\n",
        "for name, model in individual_models.items():\n",
        "    y_pred = model.predict(X_test_fs)\n",
        "    y_pred_proba = model.predict_proba(X_test_fs)[:, 1]\n",
        "    metrics = evaluate_model(y_test.values, y_pred, y_pred_proba, name)\n",
        "    results[name] = metrics\n",
        "    roc_data[name] = (y_test.values, y_pred_proba)\n",
        "\n",
        "# Evaluate stacking ensemble\n",
        "y_pred_stack = stacking_clf.predict(X_test_fs)\n",
        "y_pred_proba_stack = stacking_clf.predict_proba(X_test_fs)[:, 1]\n",
        "metrics_stack = evaluate_model(y_test.values, y_pred_stack, y_pred_proba_stack, 'Stacking Ensemble')\n",
        "results['Stacking Ensemble'] = metrics_stack\n",
        "roc_data['Stacking Ensemble'] = (y_test.values, y_pred_proba_stack)"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": ["## Step 9: Compare All Models"]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "source": [
        "import pandas as pd\n",
        "\n",
        "# Create comparison dataframe\n",
        "comparison_df = pd.DataFrame(results).T\n",
        "print('\"\\n" + '="*80)\n",
        "print('Model Performance Comparison')\n",
        "print('="*80)\n",
        "print(comparison_df.round(4))\n",
        "print('\\n" + '="*80)"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": ["## Step 10: ROC Curves"]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "source": [
        "from evaluate import plot_roc_curves\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# Plot ROC curves\n",
        "fig = plot_roc_curves(roc_data)\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": ["## Step 11: Confusion Matrix"]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "source": [
        "from evaluate import plot_confusion_matrix\n",
        "\n",
        "# Plot confusion matrix for ensemble\n",
        "fig, ax = plt.subplots(figsize=(6, 5))\n",
        "plot_confusion_matrix(y_test.values, y_pred_stack, 'Stacking Ensemble', ax)\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": ["## Step 12: Feature Importance"]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "source": [
        "from evaluate import plot_feature_importance\n",
        "\n",
        "# Plot feature importance from Random Forest\n",
        "if 'RandomForest' in individual_models:\n",
        "    fig = plot_feature_importance(\n",
        "        individual_models['RandomForest'],\n",
        "        X_train_fs.columns.tolist(),\n",
        "        'Random Forest',\n",
        "        top_n=20\n",
        "    )\n",
        "    plt.tight_layout()\n",
        "    plt.show()"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": ["## Step 13: Threshold Optimization"]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "source": [
        "from evaluate import optimize_threshold_pr_curve\n",
        "\n",
        "# Optimize threshold\n",
        "opt_threshold, opt_precision, opt_recall, fig = optimize_threshold_pr_curve(\n",
        "    y_test.values, y_pred_proba_stack\n",
        ")\n",
        "\n",
        "print(f'\"Optimal Threshold: {opt_threshold:.4f}')\n",
        "print(f'\"Precision: {opt_precision:.4f}')\n",
        "print(f'\"Recall: {opt_recall:.4f}')\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": ["## Step 14: Summary"]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "source": [
        "print('\"\\n" + '="*80)\n",
        "print('PIPELINE EXECUTION SUMMARY')\n",
        "print('="*80)\n",
        "\n",
        "print(f'\"\\nDataset:')\n",
        "print(f'  Total rows: {df.shape[0]:,}')\n",
        "print(f'  Total features: {df.shape[1]:,}')\n",
        "print(f'  Features after selection: {X_train_fs.shape[1]:,}')\n",
        "\n",
        "print(f'\"\\nClass Distribution:')\n",
        "print(f'  Good credit (0): {(y_test == 0).sum()} ({100*(y_test==0).sum()/len(y_test):.1f}%)')\n",
        "print(f'  Bad credit (1): {(y_test == 1).sum()} ({100*(y_test==1).sum()/len(y_test):.1f}%)')\n",
        "\n",
        "print(f'\"\\nBest Models:')\n",
        "best_auc = comparison_df['roc_auc'].idxmax()\n",
        "best_f1 = comparison_df['f1'].idxmax()\n",
        "print(f'  Best AUC-ROC: {best_auc} ({comparison_df.loc[best_auc, \"roc_auc\"]:.4f})')\n",
        "print(f'  Best F1-Score: {best_f1} ({comparison_df.loc[best_f1, \"f1\"]:.4f})')\n",
        "\n",
        "print('\"\\n" + '="*80)')"
      ]
    }
  ],
